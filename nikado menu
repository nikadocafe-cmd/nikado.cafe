<title>منوی کافه نیکادو | Nikado Café</title>
<style>
:root {
  --green: #123c32;
  --green-soft: #e7eee6;
  --cream: #fff8ec;
  --card: #fffdf8;
  --orange: #f5a623;
  --ink: #172c28;
  --muted: #68746e;
  --border: #eadfce;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: Tahoma, Arial, sans-serif;
  line-height: 1.9;
}
header {
  padding: 38px 18px 32px;
  text-align: center;
  color: #fff;
  background: radial-gradient(circle at 85% 10%, #2c6654, transparent 35%), var(--green);
  border-radius: 0 0 28px 28px;
}
.logo {
  color: #fff;
  font: italic clamp(42px, 10vw, 68px)/1.1 Georgia, serif;
}
.cafe {
  margin: 8px 0 12px;
  color: var(--orange);
  font-size: 14px;
  font-weight: bold;
  letter-spacing: .35em;
}
.tag { margin: 0; color: #e8eee9; }
main {
  width: min(100% - 28px, 1000px);
  margin: 24px auto 36px;
}
.intro {
  margin: 18px auto 26px;
  color: var(--muted);
  text-align: center;
}
nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin: 18px 0 28px;
}
nav a {
  padding: 7px 13px;
  color: var(--green);
  background: var(--green-soft);
  border: 1px solid #d2dfd3;
  border-radius: 99px;
  text-decoration: none;
  font-size: 13px;
  transition: background .2s, transform .2s;
}
nav a:hover { background: #d9e6d9; transform: translateY(-1px); }
section {
  margin: 18px 0;
  padding: 20px;
  scroll-margin-top: 16px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 6px 20px #193b2910;
}
h2 {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 0 14px;
  color: var(--green);
  font-size: 21px;
}
h2::before {
  display: inline-block;
  width: 7px;
  height: 25px;
  content: "";
  background: var(--orange);
  border-radius: 6px;
}
.items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: 12px;
}
.items article {
  min-width: 0;
  padding: 13px 15px;
  background: #f8f3e9;
  border: 1px solid #f0e7d8;
  border-radius: 12px;
}
h3 {
  margin: 0;
  color: #173e34;
  font-size: 15px;
  line-height: 1.9;
}
p { margin: 0; color: #5c6862; font-size: 13px; }
footer {
  padding: 25px 15px;
  color: #fff;
  text-align: center;
  background: var(--green);
  border-radius: 24px 24px 0 0;
}
footer strong {
  color: var(--orange);
  font: italic 28px Georgia, serif;
}
footer a { color: #fff; }
footer a:focus-visible,
nav a:focus-visible {
  outline-color: var(--orange);
}
@media (min-width: 700px) {
  section { padding: 22px 25px; }
  .intro { font-size: 16px; }
}
@media (max-width: 480px) {
  main { width: min(100% - 20px, 1000px); }
  section { padding: 15px 13px; }
  h2 { font-size: 19px; }
  .items { grid-template-columns: 1fr; }
}
</style>
</head>
